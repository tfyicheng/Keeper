<UserControl x:Class="Keeper.Views.AutostartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="启动项" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}">
                    <Run Text="扫描系统注册表与启动文件夹中的开机启动项目" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding SummaryText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="180">
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按名称或路径搜索" />
                    <TextBlock Text="搜索启动项" FontSize="13" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="添加文件" Command="{Binding AddFilesCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                <Button Content="重新扫描" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 状态 -->
        <Border Grid.Row="1" Style="{StaticResource StatusBar}" Margin="0,18,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="None" TextWrapping="Wrap" />
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,10,18,10">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EntriesView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 图标 -->
                                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                                            <Border Background="{StaticResource SoftSurfaceBrush}" CornerRadius="6" />
                                            <Image Source="{Binding Icon}" Stretch="Uniform" Width="20" Height="20" />
                                        </Grid>

                                        <!-- 名称与路径 -->
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TargetPathText}" Style="{StaticResource MutedText}"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- 来源 -->
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource MutedText}"
                                                       FontSize="11" />
                                        </Border>

                                        <!-- 打开所在文件夹 -->
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="打开所在文件夹">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphText}" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>

                                        <!-- 开关 -->
                                        <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  ToolTip="启用 / 禁用该启动项" />

                                        <!-- 删除 -->
                                        <Button Grid.Column="5" Style="{StaticResource IconButton}"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="彻底删除该启动项">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphText}" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="没有匹配的启动项"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EntriesView.IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
