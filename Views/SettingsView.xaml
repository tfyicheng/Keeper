<UserControl x:Class="Keeper.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Keeper 的行为偏好与数据位置" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
            <StackPanel>

                <!-- 启动行为 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开机自动启动 Keeper" Style="{StaticResource BodyText}" />
                                <TextBlock Text="通过 Windows 计划任务在登录后自动运行，并以管理员权限启动，登录时不会再弹权限确认"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                                      IsChecked="{Binding LaunchWithWindows, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="启动时自动恢复所选快照" Style="{StaticResource BodyText}" />
                                <TextBlock Text="开启后，Keeper 启动时按下方选择的快照依次恢复打开的程序"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                                      IsChecked="{Binding AutoRestoreOnLaunch, Mode=TwoWay}" />
                        </Grid>

                        <!-- 启动快照多选（标签式） -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="启动快照" Style="{StaticResource BodyText}" />
                            <TextBlock Text="可同时选择多条快照，恢复时依次启动；未选择时恢复最近一次快照"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding SelectedSnapshots}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
                                                Padding="9,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button Style="{StaticResource ChipCloseButton}" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.RemoveSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="从启动快照中移除">
                                                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource GlyphFontFamily}"
                                                               FontSize="9" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="尚未选择快照，启动时将恢复最近一次快照" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSnapshots.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal">
                                <Grid>
                                    <ComboBox Width="220" Style="{StaticResource FlatComboBox}"
                                              ItemsSource="{Binding AvailableSnapshots}"
                                              SelectedItem="{Binding SnapshotToAdd, Mode=TwoWay}"
                                              ToolTip="从快照记录中选择">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="选择快照…" Margin="13,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SnapshotToAdd}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Content="添加" Command="{Binding AddSnapshotCommand}"
                                        Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="恢复时跳过已运行的程序" Style="{StaticResource BodyText}" />
                                <TextBlock Text="关闭后将尝试重新启动快照中的每一个程序"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="16,0,0,0"
                                      IsChecked="{Binding RestoreSkipRunning, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 窗口与托盘 -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="窗口与托盘" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="关闭主窗口时" Style="{StaticResource BodyText}" />
                                <TextBlock Text="退到托盘后程序继续在后台运行，可通过托盘图标重新打开主界面、保存状态或退出"
                                           Style="{StaticResource MutedText}" Margin="0,4,12,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="150" Style="{StaticResource FlatComboBox}"
                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                      ItemsSource="{Binding CloseActionOptions}"
                                      SelectedItem="{Binding SelectedCloseAction, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" FontSize="13" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="数据" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SQLite 数据文件" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource MutedText}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开目录" Style="{StaticResource SecondaryButton}"
                                    Height="32" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Command="{Binding OpenDataFolderCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="数据文件与程序放在同一目录，复制整个文件夹即可完成迁移。" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}">
                                    <Run Text="Keeper " />
                                    <Run Text="{Binding VersionText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                                    <Run Text="当前权限：" />
                                    <Run Text="{Binding PrivilegeText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="以管理员身份重启"
                                    Style="{StaticResource SecondaryButton}" Height="32"
                                    VerticalAlignment="Center" Margin="16,0,0,0"
                                    Command="{Binding RestartAsAdminCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="管理「所有用户」的启动项需要管理员权限。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,14,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource StatusBar}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="None" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
