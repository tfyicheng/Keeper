<UserControl x:Class="Keeper.Views.WhitelistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="白名单" Style="{StaticResource PageTitle}" />
                <TextBlock Text="白名单中的程序保存快照时不会被记录，也可把文件拖入列表直接添加"
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="追加已勾选的启动项" Command="{Binding AddCheckedStartupItemsCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        ToolTip="把「启动项」页中已勾选（启用）的项目一键加入白名单" />
                <Button Content="添加文件" Command="{Binding AddFilesCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </Grid>

        <!-- 状态 -->
        <Border Grid.Row="1" Style="{StaticResource StatusBar}" Margin="0,18,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="None" TextWrapping="Wrap" />
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,10,18,10"
                AllowDrop="True" DragOver="EntriesHost_DragOver" Drop="EntriesHost_Drop">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 图标 -->
                                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                                            <Border Background="{StaticResource SoftSurfaceBrush}" CornerRadius="6" />
                                            <Image Source="{Binding Icon}" Stretch="Uniform" Width="20" Height="20" />
                                        </Grid>

                                        <!-- 名称与路径 -->
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource MutedText}"
                                                       FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- 打开所在文件夹 / 移除 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="打开所在文件夹">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphText}" FontSize="14"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="从白名单移除">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphText}" FontSize="14"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="白名单为空，可点击「添加文件」或把文件拖到这里"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
