<UserControl x:Class="Keeper.Views.WorkStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="820">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="工作状态" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding RunningHint}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />

                <Grid Width="160" Margin="0,0,8,0">
                    <TextBox Style="{StaticResource SearchBox}" Height="36"
                             Text="{Binding NewSnapshotName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="快照名称，留空则自动命名" />
                    <TextBlock Text="快照名称（可留空）" FontSize="12.5" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NewSnapshotName}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Content="保存当前工作状态" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <!-- 状态提示 -->
        <Border Grid.Row="1" Style="{StaticResource StatusBar}" Margin="0,18,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="None" TextWrapping="Wrap" />
        </Border>

        <!-- 主体：快照列表 + 详情 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.35*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 快照列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="历史快照" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" />
                        <Button Content="全部清空" Command="{Binding ClearSnapshotsCommand}"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                ToolTip="删除全部历史快照" />
                    </Grid>

                    <Grid>
                        <TextBlock Text="还没有保存过快照"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshots.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox ItemsSource="{Binding Snapshots}"
                                 SelectedItem="{Binding SelectedSnapshot}"
                                 ItemContainerStyle="{StaticResource SnapshotListBoxItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="6,0" />
                                            <TextBlock Text="{Binding ItemCountText}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 快照详情 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBox Style="{StaticResource InlineEditBox}"
                                     Text="{Binding SnapshotName}"
                                     ToolTip="点击可重命名快照" />
                            <TextBlock Text="{Binding SelectedSnapshot.CreatedAtText}"
                                       Style="{StaticResource MutedText}" Margin="4,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="添加文件" Command="{Binding AddFilesCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0" />
                            <Button Content="恢复" Command="{Binding RestoreCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,6,0" />
                            <Button Content="删除" Command="{Binding DeleteCommand}"
                                    Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </Grid>

                    <!-- 启动项列表 -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Background="Transparent">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource SoftSurfaceBrush}" CornerRadius="5" />
                                                    <Image Source="{Binding Icon}" Stretch="Uniform" Width="18" Height="18" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Margin="0,0,6,0" Padding="5,1" CornerRadius="3"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Setter Property="Background" Value="{StaticResource SoftSurfaceBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RequiresAdministrator}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="管理员" FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource MutedText}"
                                                               FontSize="11" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="打开所在文件夹">
                                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphText}" FontSize="14"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                            Command="{Binding DataContext.AddToWhitelistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="添加到白名单（保存快照时忽略该程序）">
                                                        <TextBlock Text="&#xE73E;" Style="{StaticResource GlyphText}" FontSize="13"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="从快照中移除">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphText}" FontSize="14"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="选择一条快照后，点击「添加文件」追加启动项"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" FontSize="11"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="支持 exe、文档、图片等任意文件，恢复时用系统默认程序打开；已在运行的程序会被跳过（可在「设置」中修改）。" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
